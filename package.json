{
  "name": "riffforge-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Cross-platform multi-track tablature, drive/distortion and MIDI drum songwriting workstation",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fetch-drum-kits.mjs",
    "fetch-drums": "node scripts/fetch-drum-kits.mjs",
    "predev": "node scripts/fetch-drum-kits.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-drum-kits.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "android:init": "tauri android init && node scripts/android-permissions.mjs && tauri icon ./app-icon.png",
    "android:dev": "node scripts/android-permissions.mjs && tauri android dev",
    "android:build": "node scripts/android-permissions.mjs && tauri android build --apk"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.6.0",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
